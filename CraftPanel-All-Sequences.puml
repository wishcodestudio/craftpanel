' ═══════════════════════════════════════════════════════════════════
' DIAGRAM 5 — AI Analyze + Apply
' ═══════════════════════════════════════════════════════════════════

title CraftPanel — POST /api/ai/analyze + /api/ai/apply (AI Diagnostics)

actor "Admin" AS user #blue_bg

box "Browser" #blue_bg
boundary "React Frontend" AS fe #FFEEEE
end box

box "CraftPanel Backend (Node.js)" #dcf0ff
entity "Express API" AS api #F5EEF8
entity "AI Service" AS ai_svc #F5EEF8
entity "File Manager" AS fm #F5EEF8
entity "RCON Client" AS rcon #F5EEF8
database "PostgreSQL" AS db #F5EEF8
end box

box "External Services" #fff8e8
entity "Anthropic\nClaude API" AS claude #FFF3CD
entity "Minecraft Server\n(RCON)" AS mc #FFF3CD
end box

== Analyze Error ==

user -> fe: Clicks "→ AI" on ERROR log line\n(or pastes error text manually)
activate fe

fe -> api: POST /api/ai/analyze\n[Header] Authorization: Bearer <JWT>\n[Body] { serverId, errorText }
activate api

group #FFFFFF Authenticate & Authorize
    api -> api: Verify JWT
    api -> db: Check user_group_access for serverId
    activate db
    db --> api: allowed
    deactivate db
    api -> api: Validate: serverId (UUID), errorText (string, max 4000 chars)
    opt Invalid
        note right of api #error_bg
            Hard Stop — Return **Status[400/401/403]**
        end note
    end opt
end group

group#Yellow ⭐ Business Logic — Analyze
    api -> ai_svc: analyzeError(errorText)
    activate ai_svc

    note right of ai_svc
        systemPrompt:
        "You are a Minecraft Java server expert.
        Respond ONLY with JSON:
        {
          explanation: string (plain English, max 3 sentences),
          fixes: [{
            title: string,
            description: string,
            steps: string[],
            filesAffected: string[],
            risk: 'low' | 'medium' | 'high'
          }]
        }
        1–3 fixes, safest first."
    end note

    ai_svc -> claude: POST /v1/messages\nmodel: claude-sonnet-4-20250514\nmax_tokens: 1000\n[Body] { system, messages: [{ role: user, content: errorText }] }
    activate claude
    opt Timeout or API error
        note right of ai_svc #error_bg
            Hard Stop — Return **Status[502]**
            - error.code = AI_001
            - error.message = "AI service unavailable"
        end note
    end opt
    claude --> ai_svc: { content: [{ type: text, text: "{ explanation, fixes[] }" }] }
    deactivate claude

    ai_svc -> ai_svc: JSON.parse(content[0].text)
    opt Parse error
        note right of ai_svc #error_bg
            Hard Stop — Return **Status[500]**
            - error.code = AI_002
            - error.message = "Unexpected AI response"
        end note
    end opt

    ai_svc --> api: { explanation, fixes[] }
    deactivate ai_svc

    api -> db: INSERT INTO activity_log (action='ai_analyzed', detail=errorText[0..100])
    activate db
    db --> api: ok
    deactivate db

    note right of api #success_bg
        Return **Status[200]**
        {
          data: {
            explanation: "Your server ran out of heap memory...",
            fixes: [
              { title, description, steps[], filesAffected[], risk: 'low' },
              { title, description, steps[], filesAffected[], risk: 'medium' }
            ]
          }
        }
    end note
end group

api --> fe: return response
deactivate api
fe --> user: Show explanation card + fix option cards (1–3)
deactivate fe

|||

== Apply Fix ==

user -> fe: Select Fix 1 card\nClick "Apply Fix 1 →"
activate fe
fe --> user: Confirmation modal:\n"Apply: Increase JVM heap allocation\nto SurvivalCraft? Will modify start.sh"

user -> fe: Click "Confirm"

fe -> api: POST /api/ai/apply\n[Header] Authorization: Bearer <JWT>\n[Body] { serverId, fix: { title, steps, filesAffected, risk } }
activate api

group #FFFFFF Re-Authenticate
    api -> api: Verify JWT
    api -> db: Re-check server access
    activate db
    db --> api: allowed
    deactivate db
end group

group#Yellow ⭐ Business Logic — Apply Fix
    api -> api: Determine fix type from fix.filesAffected + fix.steps:\nfile_edit | rcon_command | both

    api -> db: SELECT dir_path, rcon_port, rcon_password FROM servers WHERE id = $1
    activate db
    db --> api: server record
    deactivate db

    alt Fix type = file_edit
        api -> fm: writeFile(server.dir_path, filePath, newContent)
        activate fm
        fm -> fm: Resolve + validate path safety
        fm -> fm: Backup original file (.bak)
        fm -> fm: fs.writeFileSync(resolvedPath, newContent)
        opt Error
            note right of fm #error_bg
                Hard Stop — Return **Status[500]**
                - error.code = FILE_002
                - error.message = "File write failed"
            end note
        end opt
        fm --> api: { success, changesSummary }
        deactivate fm

    else Fix type = rcon_command
        api -> rcon: sendCommand(rcon_port, rcon_password, command)
        activate rcon
        rcon -> mc: RCON TCP → command
        activate mc
        mc --> rcon: command output
        deactivate mc
        opt RCON failed
            note right of rcon #error_bg
                Hard Stop — Return **Status[502]**
                - error.code = RCON_001
                - error.message = "Could not reach Minecraft server"
            end note
        end opt
        rcon --> api: { success, output }
        deactivate rcon
    end alt

    api -> db: INSERT INTO activity_log (action='ai_applied_fix', detail=fix.title)
    activate db
    db --> api: ok
    deactivate db

    note right of api #success_bg
        Return **Status[200]**
        {
          data: {
            success: true,
            changesSummary: "Increased -Xmx from 2G to 4G in start.sh",
            nextActions: ["reload_plugins", "restart_server"]
          }
        }
    end note
end group

api --> fe: return response
deactivate api
fe --> user: Show "✓ Fix Applied" success card\n[Reload Plugins] [Restart Server] buttons
deactivate fe

