@startuml
hide footbox
skinparam ParticipantPadding 10
skinparam BoxPadding 10
!define error_bg FA8072
!define success_bg LightGreen
!define blue_bg e3fcff

' ═══════════════════════════════════════════════════════════════════
' DIAGRAM 1 — Login
' ═══════════════════════════════════════════════════════════════════

title CraftPanel — POST /api/auth/login

actor "Admin" AS user #blue_bg

box "Browser" #blue_bg
boundary "React Frontend" AS fe #FFEEEE
end box

box "CraftPanel Backend (Node.js)" #dcf0ff
entity "Express API" AS api #F5EEF8
database "PostgreSQL" AS db #F5EEF8
end box

== Login ==

user -> fe: Enter username + password, click Sign In
activate fe

fe -> api: POST /api/auth/login\n[Body] { username, password }
activate api

group #FFFFFF Validate Request
    api -> api: Validate: username (non-empty), password (non-empty)
    opt Missing fields
        note right of api #error_bg
            Hard Stop — Return **Status[400]**
            - error.code = VAL_001
            - error.message = "Invalid or missing parameters"
        end note
    end opt
end group

group #FFFFFF Verify Credentials
    api -> db: SELECT id, username, password_hash, role\nFROM users WHERE username = $1
    activate db
    db --> api: user record or null
    deactivate db

    opt User not found
        note right of api #error_bg
            Hard Stop — Return **Status[401]**
            - error.code = AUTH_001
            - error.message = "Invalid username or password"
        end note
    end opt

    api -> api: bcrypt.compare(password, user.password_hash)
    opt Password does not match
        note right of api #error_bg
            Hard Stop — Return **Status[401]**
            - error.code = AUTH_001
            - error.message = "Invalid username or password"
        end note
    end opt
end group

group#Yellow ⭐ Issue Token & Load Access
    api -> db: SELECT sg.id, sg.name\nFROM server_groups sg\nJOIN user_group_access uga ON sg.id = uga.group_id\nWHERE uga.user_id = $1
    activate db
    db --> api: assignedGroups[]
    deactivate db

    api -> api: jwt.sign({ userId, username, role, groupIds[] }, JWT_SECRET, { expiresIn: '8h' })

    api -> db: INSERT INTO activity_log\n(user_id, action, created_at)\nVALUES ($1, 'logged_in', now())
    activate db
    db --> api: ok
    deactivate db

    note right of api #success_bg
        Return **Status[200]**
        {
          token: "eyJ...",
          user: { id, username, role },
          groups: [{ id, name, servers[] }]
        }
    end note
end group

api --> fe: return response
deactivate api

fe -> fe: Store token in memory (Redux)\nStore groups in Redux serverSlice
fe --> user: Redirect to Dashboard
deactivate fe

newpage

' ═══════════════════════════════════════════════════════════════════
' DIAGRAM 2 — GET File List
' ═══════════════════════════════════════════════════════════════════

title CraftPanel — GET /api/files (File Manager Directory Listing)

actor "Admin" AS user #blue_bg

box "Browser" #blue_bg
boundary "React Frontend" AS fe #FFEEEE
end box

box "CraftPanel Backend (Node.js)" #dcf0ff
entity "Express API" AS api #F5EEF8
entity "File Manager" AS fm #F5EEF8
database "PostgreSQL" AS db #F5EEF8
end box

== Browse Files ==

user -> fe: Navigate to File Manager\nor click a folder in the browser
activate fe

fe -> api: GET /api/files?serverId=<uuid>&path=/plugins\n[Header] Authorization: Bearer <JWT>
activate api

group #FFFFFF Authenticate & Authorize
    api -> api: Verify JWT signature and expiry
    opt Invalid token
        note right of api #error_bg
            Hard Stop — Return **Status[401]**
            - error.code = AUTH_001
            - error.message = "Unauthorized"
        end note
    end opt

    api -> db: Check user_group_access for serverId
    activate db
    db --> api: allowed / denied
    deactivate db
    opt No access
        note right of api #error_bg
            Hard Stop — Return **Status[403]**
            - error.code = AUTH_002
            - error.message = "Permission Denied"
        end note
    end opt
end group

group#Yellow ⭐ Business Logic — List Directory
    group Resolve Safe Path
        api -> db: SELECT dir_path FROM servers WHERE id = $1
        activate db
        db --> api: server.dir_path (e.g. /home/mc/server-1/main)
        deactivate db

        api -> fm: listDirectory(server.dir_path, requestedPath)
        activate fm
        fm -> fm: resolvedPath = path.resolve(server.dir_path, requestedPath)\nValidate: resolvedPath.startsWith(server.dir_path)
        opt Path traversal attempt
            note right of fm #error_bg
                Hard Stop — Return **Status[403]**
                - error.code = FILE_001
                - error.message = "Path not allowed"
            end note
        end opt
    end group

    group Read Directory
        fm -> fm: fs.readdirSync(resolvedPath, { withFileTypes: true })
        opt Directory not found or read error
            note right of fm #error_bg
                Hard Stop — Return **Status[404]**
                - error.code = FILE_003
                - error.message = "Path not found"
            end note
        end opt

        loop entry in dirEntries
            note right of fm
                files.push({
                    name: entry.name,
                    type: entry.isDirectory() ? 'dir' : 'file',
                    size: entry.isFile() ? fs.statSync().size : null,
                    modified: fs.statSync().mtime
                })
            end note
        end loop

        fm --> api: { files[] }
        deactivate fm
    end group

    note right of api #success_bg
        Return **Status[200]**
        {
          data: {
            path: "/plugins",
            files: [{ name, type, size, modified }]
          }
        }
    end note
end group

api --> fe: return response
deactivate api
fe --> user: Render file/folder list in left panel
deactivate fe

newpage

' ═══════════════════════════════════════════════════════════════════
' DIAGRAM 3 — Save File
' ═══════════════════════════════════════════════════════════════════

title CraftPanel — PUT /api/files/content (Save File)

actor "Admin" AS user #blue_bg

box "Browser" #blue_bg
boundary "React Frontend" AS fe #FFEEEE
end box

box "CraftPanel Backend (Node.js)" #dcf0ff
entity "Express API" AS api #F5EEF8
entity "File Manager" AS fm #F5EEF8
database "PostgreSQL" AS db #F5EEF8
end box

== Save File ==

user -> fe: Edit file in Monaco editor\nClick "Save File"
activate fe

fe -> fe: Show confirmation modal:\n"Save changes to /plugins/EssentialsX/config.yml\non SurvivalCraft?"

user -> fe: Click "Confirm"

fe -> api: PUT /api/files/content\n[Header] Authorization: Bearer <JWT>\n[Body] { serverId, path: "/plugins/EssentialsX/config.yml", content: "..." }
activate api

group #FFFFFF Authenticate & Authorize
    api -> api: Verify JWT
    api -> db: Check user_group_access for serverId
    activate db
    db --> api: allowed
    deactivate db
end group

group#Yellow ⭐ Business Logic — Write File
    api -> db: SELECT dir_path FROM servers WHERE id = $1
    activate db
    db --> api: server.dir_path
    deactivate db

    api -> fm: writeFile(server.dir_path, requestedPath, content)
    activate fm

    fm -> fm: resolvedPath = path.resolve(server.dir_path, requestedPath)\nValidate resolvedPath.startsWith(server.dir_path)
    opt Path traversal
        note right of fm #error_bg
            Hard Stop — Return **Status[403]**
            - error.code = FILE_001
            - error.message = "Path not allowed"
        end note
    end opt

    fm -> fm: Create backup: fs.copyFileSync(resolvedPath, resolvedPath + '.bak')
    fm -> fm: fs.writeFileSync(resolvedPath, content, 'utf8')
    opt Write fails
        note right of fm #error_bg
            Hard Stop — Return **Status[500]**
            - error.code = FILE_002
            - error.message = "File write failed"
        end note
    end opt

    fm --> api: { success: true }
    deactivate fm

    group Log Activity
        api -> db: INSERT INTO activity_log\n(user_id, server_id, action, detail, created_at)\nVALUES ($1, $2, 'edited_file', '/plugins/EssentialsX/config.yml', now())
        activate db
        db --> api: ok
        deactivate db
    end group

    note right of api #success_bg
        Return **Status[200]**
        { data: { success: true, path: "/plugins/EssentialsX/config.yml" } }
    end note
end group

api --> fe: return response
deactivate api
fe --> user: Show toast "File saved ✓"\nClear unsaved-changes dot on tab
deactivate fe

newpage

' ═══════════════════════════════════════════════════════════════════
' DIAGRAM 4 — Terminal Command
' ═══════════════════════════════════════════════════════════════════

title CraftPanel — WebSocket terminal:input (Terminal Command)

actor "Admin" AS user #blue_bg

box "Browser" #blue_bg
boundary "React Frontend\n(xterm.js)" AS fe #FFEEEE
end box

box "CraftPanel Backend (Node.js)" #dcf0ff
entity "socket.io Server" AS ws #F5EEF8
entity "Terminal Manager\n(node-pty)" AS pty #F5EEF8
database "PostgreSQL" AS db #F5EEF8
end box

box "Minecraft Server" #fff8e8
entity "Bash Shell" AS shell #FFF3CD
end box

== Terminal: Connect ==

user -> fe: Navigate to Terminal page
activate fe
fe -> ws: socket.emit('terminal:connect', { serverId })\n[Auth] JWT sent in socket handshake
activate ws

ws -> ws: Verify JWT from handshake\nCheck user_group_access for serverId
ws -> db: SELECT dir_path, name FROM servers WHERE id = $1
activate db
db --> ws: server record
deactivate db

ws -> pty: spawnTerminal(serverId, server.dir_path)
activate pty
pty -> shell: spawn('bash', [], { cwd: server.dir_path, env: {...} })
activate shell
shell --> pty: pty handle
pty --> ws: terminal ready
ws --> fe: socket.emit('terminal:ready')

== Terminal: Send Keystroke ==

user -> fe: Types command, presses Enter
fe -> fe: Check command against dangerous list\n(stop, restart, op, ban, rm -rf, ...)

alt Command is NOT dangerous
    fe -> ws: socket.emit('terminal:input', { serverId, data: 'tps\r' })
    ws -> pty: pty.write(data)
    pty -> shell: forward keystrokes
    shell --> pty: output data
    pty --> ws: onData callback
    ws --> fe: socket.emit('terminal:output', { serverId, data: '...' })
    fe --> user: xterm.js renders output

    ws -> db: INSERT INTO activity_log\n(user_id, server_id, action, detail)\nVALUES ($1, $2, 'ran_command', 'tps')
    activate db
    db --> ws: ok
    deactivate db

else Command IS dangerous (e.g. "stop")
    fe --> user: Show confirmation modal:\n"Run 'stop' on SurvivalCraft?\nThis will shut down the server."
    user -> fe: Click "Run Anyway"
    fe -> ws: socket.emit('terminal:input', { serverId, data: 'stop\r' })
    ws -> pty: pty.write(data)
    pty -> shell: forward
    shell --> pty: output
    pty --> ws: onData
    ws --> fe: socket.emit('terminal:output', { serverId, data: '...' })
    fe --> user: xterm.js renders output

    ws -> db: INSERT INTO activity_log (action='ran_dangerous_command', detail='stop')
    activate db
    db --> ws: ok
    deactivate db
end alt

== Terminal: Resize ==

user -> fe: Resize browser window
fe -> ws: socket.emit('terminal:resize', { serverId, cols: 120, rows: 40 })
ws -> pty: pty.resize(cols, rows)
pty -> shell: SIGWINCH

== Terminal: Disconnect ==

user -> fe: Navigate away from Terminal page
fe -> ws: socket.disconnect()
ws -> pty: killTerminal(serverId)
pty -> shell: pty.kill()
deactivate shell
deactivate pty
deactivate ws
deactivate fe

