' ═══════════════════════════════════════════════════════════════════
' DIAGRAM 6 — Live Log Streaming
' ═══════════════════════════════════════════════════════════════════

title CraftPanel — WebSocket subscribe:logs (Live Console Streaming)

actor "Admin" AS user #blue_bg

box "Browser" #blue_bg
boundary "React Frontend" AS fe #FFEEEE
end box

box "CraftPanel Backend (Node.js)" #dcf0ff
entity "socket.io Server" AS ws #F5EEF8
entity "Log Watcher\n(chokidar)" AS watcher #F5EEF8
database "PostgreSQL" AS db #F5EEF8
end box

box "Minecraft Server" #fff8e8
entity "logs/latest.log" AS logfile #FFF3CD
end box

== Subscribe to Live Logs ==

user -> fe: Open Dashboard or navigate to server
activate fe

fe -> ws: socket.emit('subscribe:logs', { serverId })\n[Auth] JWT in socket handshake
activate ws

ws -> ws: Verify JWT\nCheck user_group_access for serverId

ws -> db: SELECT dir_path FROM servers WHERE id = $1
activate db
db --> ws: server.dir_path
deactivate db

ws -> watcher: startWatching(serverId, dir_path + '/logs/latest.log')
activate watcher

watcher -> logfile: Read last 200 lines (initial backfill)
activate logfile
logfile --> watcher: lines[]
deactivate logfile

watcher --> ws: emit initial lines
ws --> fe: socket.emit('log:backfill', { serverId, lines[] })
fe --> user: Render last 200 log lines\nColour-coded by level (INFO=blue, WARN=amber, ERROR=red)

== Streaming New Lines ==

loop Minecraft server writes new log lines
    logfile -> watcher: chokidar 'change' event
    watcher -> watcher: Read new lines since last position
    watcher --> ws: newLines[]
    ws --> fe: socket.emit('log:line', { serverId, time, level, msg })
    fe --> user: Append line to console\nAuto-scroll if user is at bottom
    opt level = ERROR or WARN
        fe --> user: Show "→ AI" button on that line
    end opt
end loop

== Unsubscribe ==

user -> fe: Navigate away from Dashboard
fe -> ws: socket.emit('unsubscribe:logs', { serverId })
ws -> watcher: stopWatching(serverId)
deactivate watcher
deactivate ws
deactivate fe

@enduml
